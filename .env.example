# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Public HTTPS address of the website (used in the customer QR code)
PUBLIC_URL=http://localhost:3000
# Set true when running behind nginx/Caddy/Cloudflare
TRUST_PROXY=false
# Comma-separated list of allowed browser origins (leave empty = same-origin only)
CORS_ORIGINS=

DATA_DIR=./data
DB_FILE=./data/murshid.db
UPLOAD_DIR=./uploads

# First administrator (created by `npm run create-admin`). Password: 12+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Raman143143@@

SESSION_TTL_HOURS=12
BACKUP_DIR=./backups

# Payment gateway (Phase 3) - leave blank until merchant onboarding is complete
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Allowed only when NODE_ENV is not production; payments are clearly labelled TEST
PAYMENT_TEST_MODE=false
